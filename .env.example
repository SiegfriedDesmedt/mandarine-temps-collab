# Copier ce fichier vers .env puis completer les valeurs.
ODOO_LOGIN=
ODOO_PASSWORD=

# API Sellsy V2 en lecture seule
SELLSY_CLIENT_ID=
SELLSY_CLIENT_SECRET=
SELLSY_EXPERIENCE_CLIENT_ID=
SELLSY_EXPERIENCE_CLIENT_SECRET=
